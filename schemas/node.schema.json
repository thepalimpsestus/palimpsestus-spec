{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://palimpsestus.org/schemas/node.schema.json",
  "title": "Palimpsestus Derivation Node Schema",
  "description": "Schema for an individual entry in the Palimpsestus 4x4 matrix derivation lattice.",
  "type": "object",
  "required": [
    "id",
    "title",
    "cell",
    "derivational_state",
    "epistemic_tier",
    "one_sentence_summary",
    "irreducible_claim",
    "corollaries",
    "irreducibility_proof",
    "governing_grammar_version"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^(CC|CL|CP|CI|LC|LL|LP|LI|PC|PL|PP|PI|IC|IL|IP|II)-[0-9]+$"
    },
    "title": {
      "type": "string",
      "minLength": 3
    },
    "cell": {
      "type": "string",
      "enum": ["CC", "CL", "CP", "CI", "LC", "LL", "LP", "LI", "PC", "PL", "PP", "PI", "IC", "IL", "IP", "II"]
    },
    "derivation_type": {
      "type": "string",
      "enum": ["CellCrossing", "LayerFold", "AntecedentRoot"]
    },
    "derives_from": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Left/horizontal parent entries (for Cell Crossings)"
    },
    "folds_from": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Minimal sufficient support set S(X_r,C) in antecedent layer (for Layer Folds)"
    },
    "applies_to": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Above/vertical parent entries"
    },
    "derivational_state": {
      "type": "string",
      "enum": ["IRREDUCIBLE", "SUBSUMED", "BARREN"]
    },
    "epistemic_tier": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5,
      "description": "1: Minimal Observation, 2: Constitutive Axiom, 3: Derived Consequence, 4: Empirical Hypothesis, 5: Engineering Policy"
    },
    "one_sentence_summary": {
      "type": "string"
    },
    "irreducible_claim": {
      "type": "string"
    },
    "corollaries": {
      "type": "array",
      "items": { "type": "string" }
    },
    "irreducibility_proof": {
      "type": "string"
    },
    "out_edge": {
      "type": "string",
      "default": "Mapped"
    },
    "governing_grammar_version": {
      "type": "string",
      "pattern": "^C_[0-9]+$"
    }
  },
  "additionalProperties": false
}
